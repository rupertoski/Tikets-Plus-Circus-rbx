function dibujarFunciones(){
  if(!circoActual)return;
  const fecha=$("fecha").value;
  const funciones=circoActual.funciones.filter(f=>f.fecha===fecha);
  $("funcion").replaceChildren();
  funciones.forEach(f=>$("funcion").append(opcion(f.id,f.nombre)));
  dibujarDetalles();
}

function contarReservas(c,f,s){
  return reservas.filter(r=>
    r.circoId===c.id &&
    r.funcionId===f.id &&
    r.seccionId===s.id
  ).length;
}

function dibujarDetalles(){
  const f=obtenerFuncion();
  seccionElegida=null;
  $("estado").textContent="";
  $("horarios").replaceChildren();
  $("secciones").replaceChildren();

  if(!f)return;

  Object.entries(f.horarios).forEach(([pais,hora])=>{
    const tarjeta=document.createElement("div");
    tarjeta.className="hora";
    const nombre=document.createElement("strong");
    nombre.textContent=pais;
    const tiempo=document.createElement("span");
    tiempo.textContent=hora;
    tarjeta.append(nombre,tiempo);
    $("horarios").append(tarjeta);
  });

  dibujarSecciones();
}

function dibujarSecciones(){
  const c=circoActual;
  const f=obtenerFuncion();
  const contenedor=$("secciones");
  contenedor.replaceChildren();

  if(!c||!f)return;

  f.secciones.forEach(s=>{
    const ocupados=contarReservas(c,f,s);
    const disponibles=Math.max(0,s.capacidad-ocupados);
    const porcentaje=s.capacidad>0?Math.min(100,ocupados/s.capacidad*100):100;
    const agotado=disponibles===0;

    const b=document.createElement("button");
    b.type="button";
    b.className="tarjeta-seccion"+(seccionElegida===s.id?" elegida":"");
    b.disabled=agotado;

    const nombre=document.createElement("span");
    nombre.className="nombre-seccion";
    nombre.textContent=s.nombre;

    const datos=document.createElement("span");
    datos.className="datos-cupo";
    datos.textContent="Ocupados: "+ocupados+" / "+s.capacidad;

    const barra=document.createElement("div");
    barra.className="barra";

    const progreso=document.createElement("div");
    progreso.className="progreso"+(agotado?" lleno":"");
    progreso.style.width=porcentaje+"%";
    barra.append(progreso);

    const estado=document.createElement("span");
    estado.className="estado-seccion";
    estado.textContent=agotado
      ?"🔴 AGOTADO"
      :"🟢 "+disponibles+" cupos disponibles";

    b.append(nombre,datos,barra,estado);

    if(!agotado){
      b.addEventListener("click",()=>{
        seccionElegida=s.id;
        dibujarSecciones();
        $("estado").textContent="Has seleccionado "+s.nombre+".";
      });
    }

    contenedor.append(b);
  });
}

$("fecha").addEventListener("change",dibujarFunciones);
$("funcion").addEventListener("change",dibujarDetalles);

$("reservar").addEventListener("click",()=>{
  const usuario=$("usuario").value.trim();
  const f=obtenerFuncion();
  const s=obtenerSeccion();

  if(!circoActual||!f||!s){
    $("estado").textContent="Selecciona primero un circo, una función y una sección.";
    return;
  }

  if(!/^[a-zA-Z0-9_]{3,20}$/.test(usuario)){
    $("estado").textContent="Escribe un usuario de Roblox válido (3 a 20 caracteres).";
    return;
  }

  const yaReservo=reservas.some(r=>
    r.circoId===circoActual.id &&
    r.usuario.toLowerCase()===usuario.toLowerCase()
  );

  if(yaReservo){
    $("estado").textContent="Este usuario ya tiene una reserva en este circo.";
    return;
  }

  const ocupados=contarReservas(circoActual,f,s);

  if(ocupados>=s.capacidad){
    $("estado").textContent="Esta sección acaba de agotarse.";
    dibujarSecciones();
    return;
  }

  reservas.push({
    circoId:circoActual.id,
    circo:circoActual.nombre,
    funcionId:f.id,
    fecha:f.fecha,
    funcion:f.nombre,
    seccionId:s.id,
    seccion:s.nombre,
    usuario
  });

  guardar();

  $("estado").textContent=
    "¡Reserva de prueba registrada! Sección: "+s.nombre+
    ". Recuerda que todavía solo se guarda en este navegador.";

  seccionElegida=null;
  dibujarSecciones();
});

